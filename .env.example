# ===== Endline 2026 — environment variables =====
# Copy this file to ".env.local" for local development, and add the SAME
# keys in Vercel (Project -> Settings -> Environment Variables) for production.
# NEVER commit real values. .env.local is already git-ignored.

# --- MongoDB Atlas ---
# Atlas -> Connect -> Drivers -> copy the connection string, replace <password>.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# --- KoBoToolbox ---
# Account Settings -> Security -> API key (token).
KOBO_TOKEN="your_kobo_api_token_here"
# The form's asset UID (already set to the Kharif 2026 Endline Survey).
KOBO_FORM="a8moiXkkGSokVURs4yXXg2"
# KoBo server base. Global server is the default below.
KOBO_BASE="https://kf.kobotoolbox.org"

# --- Login (Level 2) ---
# ADMIN_PASSWORD = master password (comma-separate for multiple admins).
ADMIN_PASSWORD="change-me-admin"
# GUEST_PASSWORD = optional read-only viewer password (can also be set in-app).
GUEST_PASSWORD=""

# --- Optional: protect the daily cron sync ---
# If set, Vercel Cron must send "Authorization: Bearer <CRON_SECRET>".
# Vercel injects this automatically when you add a CRON_SECRET env var.
CRON_SECRET=""
